{{#
    @name {{ name }}
    @desc The {{ name }} page builder block.
    @set page.page_builder.{{ filepath_dotted }}{{ filename }}
#}}

<!-- /page_builder/{{ filepath }}_{{ filename }}.antlers.html -->
{{ partial:page_builder/block }}
    <h3 class="span-content text-center">🔧<br>{{ name }}</h3>
{{ /partial:page_builder/block }}
<!-- End: /page_builder/{{ filepath }}_{{ filename }}.antlers.html -->
