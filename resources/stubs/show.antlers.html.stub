{{#
    @name {{ collection_name }} show
    @desc The {{ collection_name }} show template.
#}}

<!-- /{{ filename }}/show.antlers.html -->
<main class="page-builder" id="content">
    <header class="fluid-grid">
        <h1 class="span-content">{{ title }}</h1>
    </header>

    {{ page_builder scope="block" }}
        {{ partial src="page_builder/{type}" }}
    {{ /page_builder }}
</main>
<!-- /{{ filename }}/show.antlers.html -->
